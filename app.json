{
  "expo": {
    "name": "SeatReg",
    "slug": "seatreg",
    "version": "1.3.0",
    "description": "Mobile companion app for the SeatReg WordPress plugin.",
    "githubUrl": "https://github.com/SiimKirjanen/seatreg-app",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "experiments": {
      "baseUrl": "/wp-content/plugins/seatreg/companion_app"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.seatreg",
      "versionCode": 19,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2e4304e5-14f3-4a52-8af8-0128cfa140ff"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 80,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/push-notification.png",
          "color": "#61B329"
        }
      ],
      "expo-background-task"
    ]
  }
}
